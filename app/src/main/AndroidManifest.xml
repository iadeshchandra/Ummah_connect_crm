<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".UmmahConnectApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.StaffLoginActivity" />
        <activity android:name=".ui.auth.AdminLoginActivity" />
        <activity android:name=".ui.auth.PinGenerationActivity" />

        <activity android:name=".ui.main.DashboardActivity" />

        <activity android:name=".ui.members.MemberListActivity" />
        <activity android:name=".ui.members.AddEditMemberActivity" />
        <activity android:name=".ui.members.MemberDetailActivity" />
        <activity android:name=".ui.guests.GuestListActivity" />
        <activity android:name=".ui.guests.AddEditGuestActivity" />

        <activity android:name=".ui.ledger.LedgerActivity" />
        <activity android:name=".ui.ledger.AddTransactionActivity" />
        <activity android:name=".ui.ledger.DeepScannerActivity" />

        <activity android:name=".ui.reports.PdfReportsActivity" />
        <activity android:name=".ui.comms.ShuraPollsActivity" />
        <activity android:name=".ui.calendar.HijriCalendarActivity" />
        <activity android:name=".ui.audit.AuditLogActivity" />

        <service
            android:name=".service.UmmahMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
